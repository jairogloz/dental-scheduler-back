                  "    pm.expect(response.data.total_charges_cents).to.eql(0);",
                  "    pm.expect(response.data.total_discounts_cents).to.eql(0);",
                  "    pm.expect(response.data.total_payments_cents).to.eql(0);",
                  "    pm.expect(response.data.total_refunds_cents).to.eql(0);",
                  "    pm.expect(response.data.balance_due_cents).to.eql(0);",
                  "});",
                  "",
                  "pm.test(\"payments are empty\", function () {",
                  "    pm.expect(response.data.payments_by_currency).to.deep.eql({});",
                  "    pm.expect(response.data.payments_by_method).to.deep.eql({});",
                  "});"
                ],
