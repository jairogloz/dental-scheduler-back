        {
          "name": "Create Appointment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Parse the response body",
                  "const response = pm.response.json();",
                  "",
                  "// Test that success is true",
                  "pm.test(\"Response success is true\", function () {",
                  "    pm.expect(response.success).to.be.true;",
                  "});",
                  "",
                  "// Extract the appointment ID from data.id",
                  "const appointment_id = response.data.id;",
                  "",
                  "// Set as environment variable",
                  "pm.environment.set(\"appointment_id\", appointment_id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Get current time",
                  "const now = new Date();",
                  "",
                  "// Add 1 hour and round to top of hour",
                  "const startTime = new Date(now);",
                  "startTime.setHours(startTime.getHours() + 1);",
                  "startTime.setMinutes(0);",
                  "startTime.setSeconds(0);",
                  "startTime.setMilliseconds(0);",
                  "",
                  "// Add 30 minutes to start time for end time",
                  "const endTime = new Date(startTime);",
                  "endTime.setMinutes(endTime.getMinutes() + 30);",
                  "",
                  "// Format to ISO 8601 (RFC3339) format",
                  "const start_time = startTime.toISOString();",
                  "const end_time = endTime.toISOString();",
                  "",
                  "// Set as collection variables",
                  "pm.collectionVariables.set(\"start_time\", start_time);",
                  "pm.collectionVariables.set(\"end_time\", end_time);",
                  "",
                  "// Log for debugging",
                  "//console.log(\"Start Time:\", start_time);",
                  "//console.log(\"End Time:\", end_time);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "id": "46b87c96-fced-4f1e-aa1b-b999eb133e89",
          "request": {
