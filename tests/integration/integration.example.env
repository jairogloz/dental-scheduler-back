# Copy this file to tests/integration/.env.integration and fill values.
# The test suite auto-loads tests/integration/.env.integration.

INTEGRATION_API_URL=http://localhost:8080
INTEGRATION_AUTH_TOKEN=your_bearer_token_here
INTEGRATION_PATIENT_ID=00000000-0000-0000-0000-000000000000
INTEGRATION_DOCTOR_ID=00000000-0000-0000-0000-000000000000
INTEGRATION_UNIT_ID=00000000-0000-0000-0000-000000000000
INTEGRATION_SERVICE_ID=srv_example

# Optional (defaults to "limpieza")
INTEGRATION_TREATMENT_TYPE=limpieza
